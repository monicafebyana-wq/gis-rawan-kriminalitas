# Salin menjadi .env lalu isi nilai sebenarnya. JANGAN commit .env
# (dibaca oleh docker-compose.yml DAN backend FastAPI)

# Database
DB_HOST=localhost
DB_PORT=5432            # ganti ke 5433 kalau 5432 sudah dipakai PostgreSQL lain di laptop
DB_NAME=gis_kriminalitas
DB_USER=postgres
DB_PASSWORD=ganti_password

# Backend
CORS_ORIGINS=*          # produksi: isi alamat front end, pisahkan koma
# minimal 32 karakter acak. Buat: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=ganti_dengan_string_acak
