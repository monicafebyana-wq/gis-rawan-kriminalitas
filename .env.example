# Salin menjadi .env lalu isi nilai sebenarnya. JANGAN commit .env
PORT=3000

# Database (dipakai docker-compose.yml DAN backend)
DB_HOST=localhost
DB_PORT=5433            # ganti ke 5433 kalau 5432 sudah dipakai PostgreSQL lain di laptop
DB_NAME=db_name
DB_USER=db_user
DB_PASSWORD=db_password

JWT_SECRET=your_jwt_secret_here
